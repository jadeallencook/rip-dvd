#!/usr/bin/env bash
set -euo pipefail

RAW_URL="https://raw.githubusercontent.com/jadeallencook/rip-dvd/main/bin/rip-dvd"
VERSION="1.1.0"

print_help() {
  cat <<'EOF'
rip-dvd - rip the inserted DVD to an mp4 with HandBrakeCLI

Usage: rip-dvd [options]

Options:
  --output=NAME   Base name for the output file (default: current timestamp).
  --lang=CODE     Audio language to select, e.g. eng, fre (default: eng).
  --title=N       Rip a specific title number instead of the main feature.
  --split         Rip every title on the disc to separate files instead of just the main feature.
  --season=N      Season number. Requires --episode and --split; changes output naming to
                  "OUTPUT | Season N | Episode M.mp4", incrementing per title.
  --episode=N     Starting episode number for the first title. Requires --season and --split.
  --chapter=N     With --split, rip only the Nth detected episode on the disc (1-based). Combined
                  with --season/--episode, --episode is that single file's episode number.
  --update        Download and install the latest version from GitHub (main branch).
  --version, -v   Show the installed version.
  --help, -h      Show this help message.
EOF
}

update_self() {
  local self_path tmp remote_version
  self_path=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  tmp=$(mktemp)
  # raw.githubusercontent.com is CDN-cached for a few minutes after a push;
  # a cache-busting query param forces a fresh fetch from origin.
  if ! curl -fsSL "${RAW_URL}?nocache=$(date +%s)" -o "$tmp"; then
    echo "rip-dvd: failed to download update" >&2
    rm -f "$tmp"
    exit 1
  fi

  remote_version=$(grep -m1 '^VERSION=' "$tmp" | sed -E 's/^VERSION="([^"]*)"/\1/')
  if [[ -z "$remote_version" ]]; then
    echo "rip-dvd: could not determine remote version" >&2
    rm -f "$tmp"
    exit 1
  fi

  if [[ "$remote_version" == "$VERSION" ]]; then
    echo "rip-dvd: already up to date (v$VERSION)"
    rm -f "$tmp"
    exit 0
  fi

  echo "rip-dvd: updating from v$VERSION to v$remote_version..."
  chmod +x "$tmp"
  mv "$tmp" "$self_path"
  echo "rip-dvd: updated to v$remote_version"
}

check_dependencies() {
  if ! command -v HandBrakeCLI >/dev/null 2>&1; then
    echo "rip-dvd: HandBrakeCLI not found." >&2
    if command -v brew >/dev/null 2>&1; then
      echo "rip-dvd: installing HandBrakeCLI via Homebrew..." >&2
      brew install handbrake
    else
      echo "rip-dvd: install Homebrew (https://brew.sh) then run: brew install handbrake" >&2
      exit 1
    fi
  fi
}

output_name=""
lang="eng"
title=""
split=false
season=""
episode=""
chapter=""

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      print_help
      exit 0
      ;;
    --update)
      update_self
      exit 0
      ;;
    --version|-v)
      echo "rip-dvd v$VERSION"
      exit 0
      ;;
    --output=*) output_name="${arg#--output=}" ;;
    --lang=*) lang="${arg#--lang=}" ;;
    --title=*) title="${arg#--title=}" ;;
    --split) split=true ;;
    --season=*) season="${arg#--season=}" ;;
    --episode=*) episode="${arg#--episode=}" ;;
    --chapter=*) chapter="${arg#--chapter=}" ;;
    *)
      echo "rip-dvd: unknown argument: $arg" >&2
      echo "Usage: rip-dvd [--output=name] [--lang=eng] [--title=N] [--split] [--season=N] [--episode=N] [--chapter=N] [--update] [--version] [--help]" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$season" || -n "$episode" ]]; then
  if ! $split; then
    echo "rip-dvd: --season and --episode require --split" >&2
    exit 1
  fi
  if [[ -z "$season" || -z "$episode" ]]; then
    echo "rip-dvd: --season and --episode must be used together" >&2
    exit 1
  fi
fi

if [[ -n "$chapter" ]]; then
  if ! $split; then
    echo "rip-dvd: --chapter requires --split" >&2
    exit 1
  fi
  if ! [[ "$chapter" =~ ^[1-9][0-9]*$ ]]; then
    echo "rip-dvd: --chapter must be a positive integer" >&2
    exit 1
  fi
fi

check_dependencies

if [[ -z "$output_name" ]]; then
  output_name=$(date +%Y-%m-%d_%H%M%S)
fi

safe_name="${output_name//\//-}"
mkdir -p ~/Downloads

disk=$(drutil status 2>/dev/null | awk -F'Name: ' '/Name:/{print $2; exit}')
if [[ -z "$disk" ]]; then
  echo "rip-dvd: no optical drive found" >&2
  exit 1
fi
if ! drutil status 2>/dev/null | grep -q "Type: DVD"; then
  echo "rip-dvd: no disc loaded in $disk (is it inserted?)" >&2
  exit 1
fi

if $split; then
  echo "rip-dvd: scanning disc for episode titles..." >&2
  scan_output=$(HandBrakeCLI -i "$disk" --scan -t 0 2>&1)

  title_nums=()
  title_durs=()
  current_title=""
  while IFS= read -r line; do
    if [[ $line =~ scan:\ scanning\ title\ ([0-9]+) ]]; then
      current_title="${BASH_REMATCH[1]}"
    elif [[ -n "$current_title" && $line =~ scan:\ duration\ is\ ([0-9]+):([0-9]+):([0-9]+) ]]; then
      h="${BASH_REMATCH[1]}"; m="${BASH_REMATCH[2]}"; s="${BASH_REMATCH[3]}"
      title_nums+=("$current_title")
      title_durs+=($((10#$h * 3600 + 10#$m * 60 + 10#$s)))
      current_title=""
    fi
  done <<< "$scan_output"

  if [[ ${#title_nums[@]} -eq 0 ]]; then
    echo "rip-dvd: could not determine title/chapter structure for --split" >&2
    exit 1
  fi

  # Real episodes cluster tightly around one runtime; DVDs also often carry a
  # "Play All" title (all episodes back to back) and short menu/junk titles.
  # Junk titles are dropped by the >=60s floor before clustering, since a disc
  # can have more junk titles than episodes and would otherwise win the vote.
  # Clustering is relative (within 15% of a reference runtime) rather than
  # fixed-width buckets, so an episode that straddles a bucket edge (e.g. 24:37
  # alongside 25:30s) isn't dropped.
  candidate_durs=()
  candidate_nums=()
  for idx in "${!title_nums[@]}"; do
    if ((title_durs[idx] >= 60)); then
      candidate_durs+=("${title_durs[idx]}")
      candidate_nums+=("${title_nums[idx]}")
    fi
  done

  best_dur=0
  best_count=0
  for d in ${candidate_durs[@]+"${candidate_durs[@]}"}; do
    count=0
    for d2 in "${candidate_durs[@]}"; do
      diff=$((d2 - d)); ((diff < 0)) && diff=$((-diff))
      ((diff * 100 <= d * 15)) && ((count++))
    done
    if ((count > best_count)); then
      best_count=$count
      best_dur=$d
    fi
  done

  episode_titles=()
  for i in ${candidate_durs[@]+"${!candidate_durs[@]}"}; do
    diff=$((candidate_durs[i] - best_dur)); ((diff < 0)) && diff=$((-diff))
    if ((diff * 100 <= best_dur * 15)); then
      episode_titles+=("${candidate_nums[$i]}")
    fi
  done

  episode_count=${#episode_titles[@]}
  if ((episode_count == 0)); then
    echo "rip-dvd: could not identify episode titles for --split" >&2
    exit 1
  fi

  echo "rip-dvd: detected $episode_count episode title(s): ${episode_titles[*]} (of ${#title_nums[@]} total titles on disc)"

  # --chapter picks a single episode by its position on the disc, e.g. to
  # retry one that failed mid-batch without re-ripping the rest.
  first=1
  last=$episode_count
  if [[ -n "$chapter" ]]; then
    if ((chapter > episode_count)); then
      echo "rip-dvd: --chapter=$chapter but only $episode_count episode title(s) detected" >&2
      exit 1
    fi
    first=$chapter
    last=$chapter
  fi

  # A single unreadable title (scratches, region-protection traps) makes
  # HandBrakeCLI exit non-zero; under set -e that used to silently abort the
  # rest of the batch, so failures are collected and reported instead.
  failed=()
  for ((n = first; n <= last; n++)); do
    t="${episode_titles[$((n - 1))]}"
    if [[ -n "$season" ]]; then
      if [[ -n "$chapter" ]]; then
        episode_num=$episode
      else
        episode_num=$((episode + n - 1))
      fi
      split_output="$HOME/Downloads/${safe_name} | Season ${season} | Episode ${episode_num}.mp4"
    else
      split_output="$HOME/Downloads/${safe_name} (Title ${t}).mp4"
    fi
    echo "rip-dvd: ripping title $t ($n of $episode_count) -> $split_output"
    if ! HandBrakeCLI -i "$disk" -o "$split_output" \
      -t "$t" \
      --audio-lang-list "$lang" \
      --first-audio \
      --preset "Fast 480p30" \
      --format av_mp4 \
      --encoder x264; then
      echo "rip-dvd: failed to rip title $t ($n of $episode_count)" >&2
      if [[ -n "$season" ]]; then
        failed+=("--chapter=$n --episode=$episode_num")
      else
        failed+=("--chapter=$n")
      fi
    fi
  done

  if ((${#failed[@]} > 0)); then
    echo "rip-dvd: ${#failed[@]} episode(s) failed to rip; retry each with --split plus:" >&2
    for f in "${failed[@]}"; do
      echo "rip-dvd:   $f" >&2
    done
    exit 1
  fi
  exit 0
fi

output=~/Downloads/${safe_name}.mp4
if [[ -n "$title" ]]; then
  title_flag=(-t "$title")
else
  title_flag=(--main-feature)
fi

HandBrakeCLI -i "$disk" -o "$output" \
  "${title_flag[@]}" \
  --audio-lang-list "$lang" \
  --first-audio \
  --preset "Fast 480p30" \
  --format av_mp4 \
  --encoder x264
